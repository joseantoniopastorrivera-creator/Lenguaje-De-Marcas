<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">

    <xs:element name="pedidos">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="pedido" maxOccurs="unbounded">
                    <xs:complexType>
                        <xs:sequence>
                            
                            <xs:choice>
                                <xs:element name="empresa">
                                    <xs:simpleType>
                                        <xs:restriction base="xs:string">
                                            <xs:pattern value="[0-9]{4}"/>
                                        </xs:restriction>
                                    </xs:simpleType>
                                </xs:element>
                                
                                <xs:element name="cliente">
                                    <xs:complexType>
                                        <xs:sequence>
                                            <xs:element name="mote" type="xs:string"/>
                                        </xs:sequence>
                                        <xs:attribute name="NIF" type="xs:ID" use="required"/>
                                    </xs:complexType>
                                </xs:element>
                            </xs:choice>

                            <xs:element name="productos_solicitados">
                                <xs:complexType>
                                    <xs:sequence>
                                        <xs:element name="producto" type="xs:string" maxOccurs="unbounded"/>
                                    </xs:sequence>
                                </xs:complexType>
                            </xs:element>

                            <xs:element name="fecha" type="xs:date"/>

                            <xs:element name="factura" minOccurs="0">
                                <xs:complexType>
                                    <xs:sequence>
                                        <xs:element name="emisor" type="xs:string"/>
                                        <xs:element name="total" type="xs:decimal" maxOccurs="unbounded"/>
                                        <xs:element name="fecha_fact" type="xs:date"/>
                                    </xs:sequence>
                                    <xs:attribute name="numfactura" type="xs:ID" use="required"/>
                                    <xs:attribute name="cliente_factura" type="xs:string"/>
                                </xs:complexType>
                            </xs:element>

                        </xs:sequence>
                    </xs:complexType>
                </xs:element>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

</xs:schema>